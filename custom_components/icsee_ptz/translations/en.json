{
  "config": {
    "flow_title": "{name} ({host})",
    "step": {
      "user": {
        "title": "Pick a camera",
        "description": "These cameras were found on your network. Pick one, or enter a camera by hand.",
        "data": {
          "device": "Camera"
        }
      },
      "credentials": {
        "title": "Camera details",
        "data": {
          "name": "Name",
          "host": "Host or IP address",
          "port": "Port",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "name": "Name of the camera in Home Assistant.",
          "host": "IP address or host name of the camera.",
          "port": "DVRIP port. Usually 34567. Only change it if your camera uses a different one (e.g. behind port forwarding).",
          "username": "Usually admin.",
          "password": "The camera password (the one set in the ICSee / XMEye app). Leave empty if the camera has none."
        }
      },
      "discovery_confirm": {
        "title": "Add {name}",
        "description": "Found a camera at {host}. Enter its login to add it.",
        "data": {
          "name": "Name",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "name": "Name of the camera in Home Assistant.",
          "username": "Usually admin.",
          "password": "The camera password (the one set in the ICSee / XMEye app). Leave empty if the camera has none."
        }
      },
      "reauth_confirm": {
        "title": "Log in again",
        "description": "{name} rejected the login. Enter the current username and password.",
        "data": {
          "username": "Username",
          "password": "Password"
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "data": {
          "host": "Host or IP address",
          "port": "Port",
          "username": "Username",
          "password": "Password"
        },
        "data_description": {
          "host": "IP address or host name of the camera.",
          "port": "DVRIP port. Usually 34567. Only change it if your camera uses a different one (e.g. behind port forwarding).",
          "username": "Usually admin.",
          "password": "The camera password (the one set in the ICSee / XMEye app). Leave empty if the camera has none."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_auth": "Invalid username or password"
    },
    "abort": {
      "already_configured": "Device is already configured",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful",
      "wrong_device": "This is a different camera. Add it as a new device instead."
    }
  },
